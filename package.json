{
  "name": "openfoldui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenFoldUI — client-only tool to compare predicted (AlphaFold or your own files) vs experimental protein structures: RMSD, TM-score, GDT-TS, per-residue deviation, pLDDT-vs-error, with a workspace, batch mode, structure search, and Excel export.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "idb": "^8.0.3",
    "ml-matrix": "^6.12.0",
    "molstar": "^5.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tmalign-wasm": "^0.0.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
}
